# Vercel / application
NEXT_PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=*

# Local MVP store for mandi snapshots and future observations
AGROVANI_DATA_DIR=.data

# Existing MongoDB fallback
MONGO_URL=mongodb://localhost:27017
DB_NAME=agrovani

# Supabase. Add the real values in .env.local or Vercel Project Settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# External data services
METEOBLUE_APIKEY=
CEHUB_APIKEY=

# Approved weather/market adapters. Keep empty to use clearly labeled demo data.
INSAT_MOSDAC_BASE_URL=
INSAT_MOSDAC_API_KEY=
LOCAL_WEATHER_BASE_URL=
LOCAL_WEATHER_API_KEY=
NOAA_GFS_BASE_URL=
NOAA_API_KEY=
AGMARKNET_BASE_URL=
AGMARKNET_API_KEY=

# Gemini free-tier voice assistant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional low-latency Gemini Live agent through LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede
